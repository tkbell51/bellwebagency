{
    // Cloudflare Worker: serves the prerendered site from .output/public and handles /api/* in worker/.
    // Deploy with `npm run deploy`. Setup steps are in README.md.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "bellwebagency",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "observability": {
        "enabled": true,
    },
    "assets": {
        "directory": ".output/public",
        "binding": "ASSETS",
        // Serve /about from about/index.html and redirect /about/ → /about, matching canonical URLs
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"],
    },
    // Project requests from /start. Create with `npx wrangler d1 create bellwebagency`,
    // then paste the database_id here and run `npm run db:migrate`.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "bellwebagency",
            "database_id": "f75db7f5-6e9b-444c-ae25-ddf9f71e5ed2",
            "migrations_dir": "migrations",
        },
    ],
    // Cloudflare Email Service. The sender must be on an onboarded sending domain;
    // the recipient is locked to the studio inbox.
    "send_email": [
        {
            "name": "EMAIL",
            "allowed_destination_addresses": ["info@bellwebagency.com"],
        },
    ],
    "vars": {
        "NOTIFY_TO": "info@bellwebagency.com",
        "NOTIFY_FROM": "website@bellwebagency.com",
        // Frontend hostnames whose Turnstile tokens are accepted in production (never localhost)
        "TURNSTILE_HOSTNAMES": "bellwebagency.com",
    },
}

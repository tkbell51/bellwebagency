{
    "name": "bwa",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nuxt dev",
        "build": "NUXT_BUILD_DIR=.nuxt-build nuxt build",
        "generate": "NUXT_BUILD_DIR=.nuxt-build nuxt generate",
        "cf:dev": "npm run generate && wrangler dev",
        "cf:types": "wrangler types worker/worker-configuration.d.ts",
        "db:migrate:local": "wrangler d1 migrations apply bellwebagency --local",
        "db:migrate": "wrangler d1 migrations apply bellwebagency --remote",
        "deploy": "npm run generate && wrangler deploy",
        "lint": "eslint .",
        "postinstall": "nuxt prepare"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.7.2",
        "@fortawesome/free-brands-svg-icons": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@fortawesome/vue-fontawesome": "^3.0.8",
        "@nuxt/content": "^3.16.1",
        "@nuxt/image": "^2.1.0",
        "@nuxtjs/sitemap": "^8.6.1",
        "nuxt": "^3.21.11",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.17.0",
        "@nuxtjs/google-fonts": "^3.2.0",
        "@nuxtjs/tailwindcss": "^6.14.0",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.1.0",
        "prettier": "^3.6.0",
        "wrangler": "^4.148.0"
    }
}
